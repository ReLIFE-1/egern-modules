#!name=菜鸟App去广告
#!desc=去除菜鸟App开屏广告、首页大横幅与瀑布流、搜索栏热词、个人中心营销推广、问卷弹窗等
#!author=ReLIFE-1
#!icon=https://fastly.jsdelivr.net/gh/zirawell/R-Store@main/Res/Icon/App/cainiao.png
#!category=去广告

[Rule]
# 阻止阿里 HTTPDNS 调度，强制走系统本地 DNS 解析，确保 MITM 解密稳定生效
DOMAIN,amdc.m.taobao.com,REJECT
# 阿里/高德广告打点与日志追踪
DOMAIN,adashx.m.taobao.com,REJECT
DOMAIN,optimus-ads.amap.com,REJECT
DOMAIN,eco.taobao.com,REJECT

[URL Rewrite]
# 开屏广告与多格广告位
^https?:\/\/(cn-acs\.m|netflow-mtop)\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(show|mshow|index) - reject-dict
# 搜索栏滚动热词与推广词
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get - reject-dict
# 首页瀑布流及运营推广流
^https?:\/\/(cn-acs\.m|nbcps-mtop)\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch - reject-dict
# 底栏营销小红点与活动推广
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.tabbar\.marketing\.get - reject-dict
# 调研问卷与弹窗提示
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbmensa\.research\.researchservice\.(acquire|event|close) - reject-dict
# 小程序 CPC 推广
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbopen\.miniapp\.recommend\.cpc - reject-dict
# 活动中心与积分商城推广
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.com\.cainiao\.(cnactivitycenter|cncreditmarket\.hit\.getactivityhit) - reject-dict

[Script]
# 响应体脚本重写（剥离首页与个人中心内的广告元素，保留包裹信息）
cainiao_purge = type=http-response, pattern=^https?:\/\/(cn-acs\.m|guide-acs\.m|trade-acs\.m|e2e-mtop)\.(cainiao|taobao)\.com\/gw\/mtop\.cainiao\.(nbpresentation\.protocol\.homepage|nbpresentation\.homepage\.merge|app\.e2e\.engine), script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/cainiao.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.cainiao.com, guide-acs.m.taobao.com, acs4miniapp-inner.m.taobao.com
