#!name=京东App去广告与比价
#!desc=过滤京东开屏与信息流广告，支持商品历史价格查询（表格图/折线图/通知）。首次使用请先打开【慢慢买App-我的】提示获取CK成功后即可比价。此模块仅支持京东标准模式。
#!author=ReLIFE-1
#!icon=https://fastly.jsdelivr.net/gh/sooyaaabo/IconLibrary@main/App/JingDong.png
#!category=去广告
#!system=iOS

[Rule]
# 拦截调试与诊断广告域名
URL-REGEX,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,REJECT

[URL Rewrite]
# 开屏大图与轻量广告直接拦截
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs - reject-200
^https?:\/\/api\.m\.jd\.com\/\?loginType=11 - reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052 - reject
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) - reject-dict

[Script]
# 响应体深度净化（首页横幅、浮窗推广、物流动图、订单与个人中心营销等）
jd_clean = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome|basicConfig|cart|lite_advertising), script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jingdong.js, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 获取慢慢买 Cookie（首次使用请打开慢慢买 App 获取）
jd_price_cookie = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 详情页历史价格比价（默认启用表格图版；如需切换为折线图或通知版，注释此行并启用下方对应脚本即可）
jd_price_embed = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_embed.js, requires-body=true, max-size=-1, timeout=60
# jd_price_chart = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_chart.js, requires-body=true, max-size=-1, timeout=60
# jd_price_notify = type=http-request, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://fastly.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js, timeout=60

[MITM]
hostname = %APPEND% api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, m.360buyimg.com
