#!name=京东App去广告与比价
#!desc=过滤京东开屏与信息流广告，支持商品历史价格查询（表格图/折线图/通知）。首次使用请先打开【慢慢买App-我的】提示获取CK成功后即可比价。此模块仅支持京东标准模式。
#!author=ReLIFE-1
#!icon=https://cdn.jsdelivr.net/gh/sooyaaabo/IconLibrary@main/App/JingDong.png
#!category=去广告
#!system=iOS

[Rule]
URL-REGEX,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,REJECT
DOMAIN,httpdns.alicdn.com,REJECT
DOMAIN,httpdns-sdk.alicdn.com,REJECT
DOMAIN,httpdns.push.qq.com,REJECT
DOMAIN,httpdns.dlied1.qq.com,REJECT
DOMAIN,httpdns.baidubce.com,REJECT
DOMAIN,dns.alidns.com,REJECT
DOMAIN,doh.pub,REJECT
IP-CIDR,203.107.1.1/24,REJECT,no-resolve
IP-CIDR,119.29.29.29/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs - reject-200
^https?:\/\/api\.m\.jd\.com\/\?loginType=11 - reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052 - reject
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) - reject-dict

[Script]
# 京东去广告
jd_clean = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome|basicConfig|cart|lite_advertising), script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jingdong.js?v=2.2.0, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 获取慢慢买 Cookie (监听底栏【我的】获取设备凭证)
jd_price_cookie = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu, script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js?v=2.2.0, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 慢慢买拦截提示 (探针：捕获任意请求提示正在监听，无需 body)
jd_price_cookie_start = type=http-request, pattern=^https?:\/\/(?:[a-zA-Z0-9-]+\.)?manmanbuy\.com\/, script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js?v=2.2.0, timeout=60

# 京东比价 - 标题嵌入版
jd_price_title = type=http-response, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(wareBusiness|serverConfig|basicConfig), script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_embed.js?v=2.2.0, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 详情通知版
jd_price_notify = type=http-request, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js?v=2.2.0, timeout=60

# 京东比价 - 详情嵌入版（表格图）
jd_price_embed = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_embed.js?v=2.2.0, requires-body=true, max-size=-1, timeout=60

# 京东比价 - 详情嵌入版（折线图）
jd_price_chart = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_chart.js?v=2.2.0, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, apapia-history-weblogic.manmanbuy.com, app.manmanbuy.com, api.manmanbuy.com, *.manmanbuy.com, manmanbuy.com, m.360buyimg.com
