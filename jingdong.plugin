#!name = 京东App去广告与比价
#!desc = 1.过滤京东广告；2.历史比价信息，任选其一即可。（首次使用请先打开【慢慢买App-我的】，提示【获取ck成功🎉】即可正常比价。）\n此插件仅支持京东标准模式。
#!openUrl = https://apps.apple.com/app/id414245413
#!author = ReLIFE-1
#!tag = 去广告, 功能增强
#!system = iOS
#!homepage = https://github.com/ReLIFE-1/egern-modules
#!icon = https://cdn.jsdelivr.net/gh/sooyaaabo/IconLibrary@main/App/JingDong.png

[Argument]
Manmanbuy_Cookie = switch, true, false, tag = [京东比价]获取慢慢买 Cookie, desc = 首次使用请先打开【慢慢买】APP，提示【获取ck成功🎉】即可正常比价。
JDPrice_TitleEmbed = switch, false, true, tag = [京东比价]标题嵌入版, desc = 点击商品标题即可直接查看嵌入式历史价格
JDPrice_DetailNotify = switch, false, true, tag = [京东比价]详情通知版, desc = 点击商品详情页通过弹窗通知查看历史价格
JDPrice_DetailEmbed_Table = switch, true, false, tag = [京东比价]详情嵌入版（表格图）, desc = 点击商品详情页即可直接查看嵌入式历史价格
JDPrice_DetailEmbed_Line = switch, false, true, tag = [京东比价]详情嵌入版（折线图）, desc = 点击商品详情页即可直接查看嵌入式历史价格

[Rule]
URL-REGEX, ^http:\/\/\w{32}\.jddebug\.com\/diagnose\?, REJECT
DOMAIN, httpdns.alicdn.com, REJECT
DOMAIN, httpdns-sdk.alicdn.com, REJECT
DOMAIN, httpdns.push.qq.com, REJECT
DOMAIN, httpdns.dlied1.qq.com, REJECT
DOMAIN, httpdns.baidubce.com, REJECT
DOMAIN, dns.alidns.com, REJECT
DOMAIN, doh.pub, REJECT
IP-CIDR, 203.107.1.1/24, REJECT, no-resolve
IP-CIDR, 119.29.29.29/32, REJECT, no-resolve

[Rewrite]
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs reject-200
^https?:\/\/api\.m\.jd\.com\/\?loginType=11 reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052 reject
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) reject-dict

[Script]
# 京东去广告与深度净化
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome) script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jingdong.js, requires-body=true, timeout=60, tag=[京东]移除广告

# 京东极速版广告
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=lite_advertising script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jingdong.js, requires-body=true, timeout=60, tag=[京东]移除京东极速版广告

# 京东比价 - 获取慢慢买 Cookie (监听底栏【我的】获取设备凭证)
http-request ^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js, requires-body=true, timeout=60, tag=[京东比价]获取慢慢买Cookie, enable={Manmanbuy_Cookie}

# 京东比价 - 慢慢买启动拦截提示 (捕获任意请求并提示正在获取，无需 body)
http-request ^https?:\/\/(?:[a-zA-Z0-9-]+\.)?manmanbuy\.com\/ script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js, timeout=60, tag=[京东比价]慢慢买拦截提示, enable={Manmanbuy_Cookie}

# 京东比价 - 标题嵌入版
http-response ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(wareBusiness|serverConfig|basicConfig) script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_embed.js, requires-body=true, timeout=60, tag=[京东比价]标题嵌入版, enable={JDPrice_TitleEmbed}

# 京东比价 - 详情通知版
http-request ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_cookie.js, timeout=60, tag=[京东比价]详情通知版, enable={JDPrice_DetailNotify}

# 京东比价 - 详情嵌入版（表格图）
http-response ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_embed.js, requires-body=true, timeout=60, tag=[京东比价]详情嵌入版（表格图）, enable={JDPrice_DetailEmbed_Table}

# 京东比价 - 详情嵌入版（折线图）
http-response ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://cdn.jsdelivr.net/gh/ReLIFE-1/egern-modules@main/scripts/jd_price_chart.js, requires-body=true, timeout=60, tag=[京东比价]详情嵌入版（折线图）, enable={JDPrice_DetailEmbed_Line}

[MitM]
hostname = api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, apapia-history-weblogic.manmanbuy.com, app.manmanbuy.com, api.manmanbuy.com, *.manmanbuy.com, manmanbuy.com, m.360buyimg.com
